rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid;
    }

    function isValidFoodItem(data) {
      return data.keys().hasAll(['id', 'name', 'calories', 'macros', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.calories is number
        && data.macros is map
        && data.macros.keys().hasAll(['carbs', 'protein', 'fat'])
        && data.macros.carbs is number
        && data.macros.protein is number
        && data.macros.fat is number
        && data.timestamp is number
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 4096));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidUserProfile(incoming());
                    
      allow update: if isSignedIn() 
                    && request.auth.uid == userId
                    && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'gender', 'goal', 'weight', 'height', 'age', 'timelineMonths', 'bmr', 'tdee', 'targetCalories', 'targetMacros', 'updatedAt'
                    ]);
      
      match /foods/{foodId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId; 
        
        allow create: if isSignedIn() 
                      && isValidId(userId) 
                      && isValidId(foodId) 
                      && request.auth.uid == userId
                      && isValidFoodItem(incoming()) 
                      && incoming().keys().size() == ('imageUrl' in incoming() ? 6 : 5);
        
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
